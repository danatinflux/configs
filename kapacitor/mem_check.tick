var warn_threshold = 80

var crit_threshold = 90

var period = 2m

var every = 2m

var data = batch
    |query('''
      SELECT last(used_percent) FROM "telegraf"."autogen"."mem"
      ''')
        .period(period)
        .every(every)
        .groupBy(*)

data
    |alert()
        .id('Alert: Memory Usage, Host: {{ index .Tags "host" }}')
        .warn(lambda: "last" >= warn_threshold)
        .crit(lambda: "last" >= crit_threshold)
        .message('Condition:{{ .Level }} {{ .ID }}, Used Percent: {{ index .Fields "last" | printf "%0.0f" }}%')
        .details('')
        .discord()
        .embedTitle('Memory Check on Host is {{ .Level }} on {{ index .Tags "host" }}!')

data
    |where(lambda: "last" > warn_threshold)
    |influxDBOut()
        .create()
        .database('chronograf')
        .measurement('alerts')
        .tag('name', 'mem_alert')
        .tag('type', 'alert_threshold')
        .tag('node', 'bobby')

