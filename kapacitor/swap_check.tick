// Swap thresholds are much lower than disk/mem -- any sustained swap use
// is a stronger signal of real memory pressure than the same percentage
// of disk or RAM would be.
var warn_threshold = 10

var crit_threshold = 50

var period = 2m

var every = 2m

var data = batch
    |query('''
      SELECT last(used_percent) FROM "telegraf"."autogen"."swap"
      ''')
        .period(period)
        .every(every)
        .groupBy(*)

data
    |alert()
        .id('Alert: Swap Usage, Host: {{ index .Tags "host" }}')
        .warn(lambda: "last" >= warn_threshold)
        .crit(lambda: "last" >= crit_threshold)
        .message('Condition:{{ .Level }} {{ .ID }}, Used Percent: {{ index .Fields "last" | printf "%0.0f" }}%')
        .details('')
        .discord()
        .embedTitle('Swap Check on Host is {{ .Level }} on {{ index .Tags "host" }}!')

data
    |where(lambda: "last" > warn_threshold)
    |influxDBOut()
        .create()
        .database('chronograf')
        .measurement('alerts')
        .tag('name', 'swap_alert')
        .tag('type', 'alert_threshold')
        .tag('node', 'bobby')

