var warn_threshold = 75

var crit_threshold = 90

// Use a larger period here, as the telegraf data can be a little late
// if the server is under load.
var period = 2m

// How often to query for the period.
var every = 2m

var data = batch
    |query('''
      SELECT last(used_percent) FROM "telegraf"."autogen"."disk"
      WHERE ("path" = '/' or "path" = '/home' or "path" = '/u01' or "path" = '/u02')
      ''')
        .period(period)
        .every(every)
        .groupBy(*)

data
    |alert()
        .id('Alert: Disk Usage, Host: {{ index .Tags "host" }} on path {{ index .Tags "path" }}')
        .warn(lambda: "last" >= warn_threshold)
        .crit(lambda: "last" >= crit_threshold)
        .message('Condition:{{ .Level }} {{ .ID }}, Used Percent: {{ index .Fields "last" | printf "%0.0f" }}%')
        .details('')
        .discord()
        .embedTitle('Disk Check on Host is {{ .Level }} on {{ index .Tags "host" }}!')

data
    |where(lambda: "last" > warn_threshold)
    |influxDBOut()
        .create()
        .database('chronograf')
        .measurement('alerts')
        .tag('name', 'disk_alert_mega2')
        .tag('type', 'alert_threshold')

